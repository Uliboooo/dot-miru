---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProfileCard from "../components/ProfileCard.astro";
import ProfileView from "../components/ProfileView.astro";
import { loadProfile, ProfileError } from "../lib/profile";
import { registry } from "../lib/registry";
import { localeFromUrl, localizedPath } from "../lib/i18n";

export const prerender = false;

const source = Astro.url.searchParams.get("source") ?? "";
const locale = localeFromUrl(Astro.url);
const isJapanese = locale === "ja";
const directoryProfiles = await Promise.all(
  registry.map(async (entry) => {
    try {
      return { entry, profile: await loadProfile(entry.source) };
    } catch {
      return { entry };
    }
  }),
);
let profile;
let error: string | undefined;
if (source) {
  try {
    profile = await loadProfile(source);
  } catch (cause) {
    error =
      cause instanceof ProfileError
        ? cause.message
        : isJapanese
          ? "プロフィールを開く途中で問題が発生しました。"
          : "Something went wrong while opening this profile.";
  }
}
---

<BaseLayout title={profile ? `${profile.name} — dot-miru` : "dot-miru"}>
  {profile ? (
    <ProfileView profile={profile} source={source} locale={locale} />
  ) : (
    <div class="home">
        <section class="intro">
          <p class="eyebrow">
            {isJapanese
              ? "dotfiles を、見やすく"
              : "dotfiles, clearly presented"}
          </p>
          <h1>A place for the tools that make your computer yours.</h1>
          <p>
            {isJapanese
              ? "dot-miru は公開 TOML ファイルを読み込み、シンプルで共有しやすいプロフィールにします。"
              : "dot-miru reads a public TOML file and turns it into a simple, shareable profile."}
          </p>
          <a class="primary-link intro-action" href={localizedPath("/editor", locale)}>
            {isJapanese ? "プロフィールを作る →" : "Create a profile →"}
          </a>
        </section>
        {error && (
          <section class="error" role="alert">
            <h2>
              {isJapanese
                ? "プロフィールを開けませんでした"
                : "Could not open this profile"}
            </h2>
            <p>{error}</p>
          </section>
        )}
        <div class="home-content">
        <section class="guide" aria-labelledby="guide-title">
          <div class="section-heading">
            <div>
              <>
                <p class="eyebrow">
                  {isJapanese ? "はじめかた" : "getting started"}
                </p>
                <h2 id="guide-title">
                  {isJapanese
                    ? "作る、公開する、共有する。"
                    : "Make, publish, and share."}
                </h2>
              </>
            </div>
          </div>
          <div class="guide-grid">
            <article>
              <>
                <h3>{isJapanese ? "1. TOML を書く" : "1. Write a TOML"}</h3>
                <p>
                  {isJapanese ? (
                    <>
                      <a href={localizedPath("/editor", locale)}>エディター</a>
                      で <code>dot-miru.toml</code> を作成・読み込みできます。
                    </>
                  ) : (
                    <>
                      Use the <a href="/editor">Editor</a> to create or load a{" "}
                      <code>dot-miru.toml</code> file.
                    </>
                  )}
                </p>
              </>
            </article>
            <article>
              <>
                <h3>
                  {isJapanese
                    ? "2. プロフィールを公開する"
                    : "2. Publish the profile"}
                </h3>
                <p>
                  {isJapanese
                    ? "エディターの公開ボタンで、短い公開URLと編集URLを作成します。"
                    : "Use the Editor's publish button to create short public and editor URLs."}
                </p>
              </>
            </article>
            <article>
              <>
                <h3>
                  {isJapanese
                    ? "3. 公開URLを共有する"
                    : "3. Share the public URL"}
                </h3>
                <p>
                  {isJapanese
                    ? "公開URLは誰にでも共有できます。編集キーを含む編集URLは非公開にしてください。"
                    : "Share the public URL with anyone. Keep the editor URL containing your edit key private."}
                </p>
                <a href={localizedPath("/editor", locale)}>
                  {isJapanese ? "プロフィールを作る →" : "Create a profile →"}
                </a>
              </>
            </article>
          </div>
        </section>
        <section class="directory" aria-labelledby="directory-title">
          <div class="section-heading">
            <>
              <div>
                <>
                  <p class="eyebrow">
                    {isJapanese ? "ディレクトリ" : "directory"}
                  </p>
                  <h2 id="directory-title">
                    {isJapanese ? "掲載プロフィール" : "Published profiles"}
                  </h2>
                </>
              </div>
              <div class="directory-actions">
                <>
                  <span>
                    {registry.length} {isJapanese ? "プロフィール" : "profiles"}
                  </span>
                  <a
                    class="primary-link"
                    href="https://github.com/Uliboooo/dot-miru/edit/main/src/data/profiles.toml"
                    target="_blank"
                    rel="noreferrer"
                  >
                    {isJapanese ? "PR で登録する" : "Register with a PR"}{" "}
                    <span aria-hidden="true">↗</span>
                  </a>
                </>
              </div>
            </>
          </div>
          {registry.length ? (
            <div class="profile-grid">
              {directoryProfiles.map(({ entry, profile }) => (
                <ProfileCard
                  slug={entry.slug}
                  profile={profile}
                  locale={locale}
                />
              ))}
            </div>
          ) : (
            <p class="empty">
              {isJapanese ? (
                <>
                  <a
                    href="https://github.com/Uliboooo/dot-miru/edit/main/src/data/profiles.toml"
                    target="_blank"
                    rel="noreferrer"
                  >
                    最初のプロフィールを PR で追加する ↗
                  </a>
                </>
              ) : (
                <>
                  No profiles are registered yet.{" "}
                  <a
                    href="https://github.com/Uliboooo/dot-miru/edit/main/src/data/profiles.toml"
                    target="_blank"
                    rel="noreferrer"
                  >
                    Add the first one with a pull request ↗
                  </a>
                </>
              )}
            </p>
          )}
        </section>
        </div>
    </div>
  )}
</BaseLayout>

<style>
  .home {
    display: grid;
    gap: 2rem;
  }

  .intro {
    align-items: end;
    display: grid;
    gap: 0 2rem;
    grid-template-columns: minmax(0, 1fr) auto;
    max-width: none;
  }

  .intro .eyebrow,
  .intro h1 {
    grid-column: 1 / -1;
  }

  .intro h1 {
    font-size: clamp(2.35rem, 4.8vw, 4rem);
    line-height: 1;
    margin-bottom: 0.75rem;
    max-width: 900px;
  }

  .intro > p:last-of-type {
    margin-bottom: 0;
  }

  .intro-action {
    white-space: nowrap;
  }

  .home-content {
    align-items: start;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 3rem;
    grid-template-columns: 1fr;
    padding-top: 2rem;
  }

  .home-content .guide,
  .home-content .directory {
    border: 0;
    margin: 0;
    padding: 0;
  }

  .directory {
    order: -1;
  }

  .guide-grid {
    grid-template-columns: 1fr;
  }

  .guide-grid article {
    display: grid;
    gap: 1rem;
    grid-template-columns: minmax(150px, 0.65fr) 1fr;
    padding: 1rem 1.1rem;
  }

  .guide-grid h3,
  .guide-grid p {
    margin: 0;
  }

  .guide-grid article > a {
    grid-column: 2;
  }

  .profile-grid {
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  }

  .profile-card {
    min-height: 0;
  }

  .directory-actions {
    align-items: center;
    display: flex;
    gap: 1rem;
  }

  .directory-actions > span {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .directory-actions .primary-link {
    font-size: 0.9rem;
    padding: 0.55rem 0.75rem;
  }

  @media (max-width: 620px) {
    .intro {
      align-items: start;
      grid-template-columns: 1fr;
    }

    .intro .eyebrow,
    .intro h1 {
      grid-column: auto;
    }

    .intro-action {
      margin-top: 1rem;
      text-align: center;
    }

    .home-content {
      grid-template-columns: 1fr;
    }

    .guide-grid article {
      grid-template-columns: 1fr;
    }

    .guide-grid article > a {
      grid-column: auto;
    }

    .directory-actions {
      align-items: start;
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>
