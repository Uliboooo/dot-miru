---
import BaseLayout from "../layouts/BaseLayout.astro";

const infoFields = [
  ["os", "OS"], ["host", "Host"], ["kernel", "Kernel"], ["shell", "Shell"],
  ["wm", "Window manager"], ["de", "Desktop environment"], ["cursor_theme", "Cursor theme"],
  ["terminal", "Terminal"], ["gpu", "GPU"], ["theme", "Theme"], ["logo", "Logo image URL"],
];
---

<BaseLayout title="TOML editor — dot-miru">
  <section class="editor-intro">
    <p class="eyebrow">TOML editor</p>
    <h1>Make your dotfiles profile.</h1>
    <p>Fill in what you want to publish, then download a ready-to-use <code>dot-miru.toml</code>. Images are linked by public HTTPS URL.</p>
  </section>

  <form class="editor-form" id="toml-editor" novalidate>
    <section class="editor-section">
      <div class="editor-section-heading"><p class="eyebrow">profile</p><span>Required fields marked *</span></div>
      <div class="editor-grid">
        <label>Display name *<input name="name" required maxlength="100" placeholder="Your name" /></label>
        <label><span class="field-label">Repository URL <span class="field-hint">recommended</span></span><input name="repository" type="url" placeholder="https://github.com/you/dotfiles" /></label>
        <label class="editor-wide">Summary<textarea name="summary" maxlength="2000" placeholder="A short introduction to your setup."></textarea></label>
        <label><span class="field-label">GitHub ID <span class="field-hint">e.g. @octocat</span></span><input name="github" maxlength="100" placeholder="@octocat" /></label>
        <label><span class="field-label">X ID <span class="field-hint">e.g. @dot_miru</span></span><input name="x" maxlength="100" placeholder="@dot_miru" /></label>
      </div>
    </section>

    <section class="editor-section">
      <div class="editor-section-heading"><p class="eyebrow">machine</p><span>Everything is optional</span></div>
      <div class="editor-grid">
        {infoFields.map(([name, label]) => <label>{label}<input name={name} type={name === "logo" ? "url" : "text"} maxlength="100" placeholder={name === "logo" ? "https://…" : undefined} /></label>)}
        <label>Fonts <span class="field-hint">comma-separated</span><input name="fonts" maxlength="2000" placeholder="Iosevka, Noto Sans JP" /></label>
        <label>Memory (GB)<input name="ram_gb" type="number" min="0.1" max="4096" step="0.1" placeholder="32" /></label>
        <label>SSD (TB) <span class="field-hint">comma-separated</span><input name="ssd_tb" inputmode="decimal" placeholder="0.5, 1" /></label>
        <label>HDD (TB) <span class="field-hint">comma-separated</span><input name="hdd_tb" inputmode="decimal" placeholder="2" /></label>
      </div>
      <div class="extra-editor" id="extra-editor">
        <div><p class="eyebrow">additional info</p><p>Up to 10 short key/value pairs.</p></div>
        <div class="extra-rows"></div>
        <button class="secondary-button add-extra" type="button">Add additional info</button>
      </div>
    </section>

    <section class="editor-section">
      <div class="editor-section-heading"><p class="eyebrow">configuration</p><span>Add public dotfiles and image URLs</span></div>
      <div id="dotfile-editors"></div>
      <button class="secondary-button" id="add-dotfile" type="button">Add dotfile</button>
    </section>

    <p class="editor-error" id="editor-error" role="alert" hidden></p>
    <div class="editor-actions"><button class="primary-link" type="submit">Download dot-miru.toml</button><a href="/">Back to directory</a></div>
  </form>
</BaseLayout>

<template id="dotfile-template">
  <article class="dotfile-editor">
    <div class="editor-card-heading"><h2>Dotfile</h2><button class="text-button remove-dotfile" type="button">Remove</button></div>
    <div class="editor-grid">
      <label>ID * <span class="field-hint">letters, numbers, _ and -</span><input class="dotfile-id" required maxlength="100" placeholder="nvim" /></label>
      <label>Name *<input class="dotfile-name" required maxlength="100" placeholder="Neovim" /></label>
      <label class="editor-wide">Description *<textarea class="dotfile-desc" required maxlength="5000" placeholder="Describe this configuration."></textarea></label>
    </div>
    <div class="image-editor"><div><p class="eyebrow">images</p><p>Public HTTPS URLs only.</p></div><div class="image-rows"></div><button class="secondary-button add-image" type="button">Add image URL</button></div>
  </article>
</template>

<template id="image-template"><div class="repeat-row"><input class="image-url" type="url" placeholder="https://example.com/screenshot.webp" /><button class="text-button remove-row" type="button">Remove</button></div></template>
<template id="extra-template"><div class="repeat-row"><input class="extra-key" maxlength="40" placeholder="display" /><input class="extra-value" maxlength="200" placeholder="2560×1600" /><button class="text-button remove-row" type="button">Remove</button></div></template>

<script>
  const form = document.querySelector<HTMLFormElement>("#toml-editor")!;
  const error = document.querySelector<HTMLParagraphElement>("#editor-error")!;
  const dotfileEditors = document.querySelector<HTMLDivElement>("#dotfile-editors")!;
  const dotfileTemplate = document.querySelector<HTMLTemplateElement>("#dotfile-template")!;
  const imageTemplate = document.querySelector<HTMLTemplateElement>("#image-template")!;
  const extraEditor = document.querySelector<HTMLDivElement>("#extra-editor")!;
  const extraTemplate = document.querySelector<HTMLTemplateElement>("#extra-template")!;

  const quote = (value: string) => JSON.stringify(value);
  const value = (name: string) => (form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement).value.trim();
  const optional = (name: string, lines: string[]) => { const item = value(name); if (item) lines.push(`${name} = ${quote(item)}`); };
  const list = (name: string) => value(name).split(",").map((item) => item.trim()).filter(Boolean);
  const isHttpsUrl = (item: string) => { try { return new URL(item).protocol === "https:"; } catch { return false; } };
  const showError = (message: string, input?: HTMLElement) => { error.textContent = message; error.hidden = false; error.scrollIntoView({ behavior: "smooth", block: "center" }); input?.focus(); };
  const clone = (template: HTMLTemplateElement) => template.content.cloneNode(true) as DocumentFragment;
  const attachRowRemoval = (row: HTMLElement) => row.querySelector<HTMLButtonElement>(".remove-row")?.addEventListener("click", () => row.remove());

  function addImage(container: Element) {
    const fragment = clone(imageTemplate);
    const row = fragment.firstElementChild as HTMLElement;
    attachRowRemoval(row);
    container.append(fragment);
  }

  function addDotfile() {
    const fragment = clone(dotfileTemplate);
    const card = fragment.firstElementChild as HTMLElement;
    card.querySelector<HTMLButtonElement>(".remove-dotfile")?.addEventListener("click", () => card.remove());
    const rows = card.querySelector(".image-rows")!;
    card.querySelector<HTMLButtonElement>(".add-image")?.addEventListener("click", () => addImage(rows));
    addImage(rows);
    dotfileEditors.append(fragment);
  }

  function addExtra() {
    const rows = extraEditor.querySelector(".extra-rows")!;
    if (rows.children.length >= 10) return;
    const fragment = clone(extraTemplate);
    attachRowRemoval(fragment.firstElementChild as HTMLElement);
    rows.append(fragment);
  }

  document.querySelector<HTMLButtonElement>("#add-dotfile")?.addEventListener("click", addDotfile);
  extraEditor.querySelector<HTMLButtonElement>(".add-extra")?.addEventListener("click", addExtra);
  addDotfile();

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    error.hidden = true;
    const fail = (message: string, input?: HTMLElement) => showError(message, input);
    const profileName = value("name");
    const repository = value("repository");
    if (!profileName) return fail("Display name is required.", form.elements.namedItem("name") as HTMLInputElement);
    if (repository && !isHttpsUrl(repository)) return fail("Repository must be an HTTPS URL.", form.elements.namedItem("repository") as HTMLInputElement);
    const lines = [`name = ${quote(profileName)}`];
    optional("summary", lines);
    if (repository) lines.push(`repository = ${quote(repository)}`);
    const github = value("github"), x = value("x");
    if (github || x) { lines.push("", "[sns]"); if (github) lines.push(`github = ${quote(github)}`); if (x) lines.push(`x = ${quote(x)}`); }
    const infoLines: string[] = [];
    ["os", "host", "kernel", "shell", "wm", "de", "cursor_theme", "terminal", "gpu", "theme", "logo"].forEach((name) => optional(name, infoLines));
    const logo = value("logo");
    if (logo && !isHttpsUrl(logo)) return fail("Logo image must be an HTTPS URL.", form.elements.namedItem("logo") as HTMLInputElement);
    const fonts = list("fonts"); if (fonts.length) infoLines.push(`fonts = [${fonts.map(quote).join(", ")}]`);
    const ram = value("ram_gb"); if (ram) infoLines.push(`ram_gb = ${Number(ram)}`);
    for (const name of ["ssd_tb", "hdd_tb"]) { const values = list(name); if (values.length) { if (values.some((item) => !Number.isFinite(Number(item)) || Number(item) <= 0)) return fail(`${name} must contain positive numbers.`); infoLines.push(`${name} = [${values.map(Number).join(", ")}]`); } }
    if (infoLines.length) lines.push("", "[info]", ...infoLines);
    const extras = [...extraEditor.querySelectorAll<HTMLElement>(".repeat-row")].map((row) => [row.querySelector<HTMLInputElement>(".extra-key")!.value.trim(), row.querySelector<HTMLInputElement>(".extra-value")!.value.trim()] as const).filter(([key, item]) => key || item);
    if (extras.length) { if (extras.some(([key, item]) => !/^[a-zA-Z0-9_-]{1,40}$/.test(key) || !item)) return fail("Additional info needs a valid key and a value."); if (new Set(extras.map(([key]) => key)).size !== extras.length) return fail("Additional info keys must be unique."); lines.push("", "[info.extra]", ...extras.map(([key, item]) => `${key} = ${quote(item)}`)); }
    for (const card of dotfileEditors.querySelectorAll<HTMLElement>(".dotfile-editor")) {
      const id = card.querySelector<HTMLInputElement>(".dotfile-id")!.value.trim();
      const name = card.querySelector<HTMLInputElement>(".dotfile-name")!.value.trim();
      const desc = card.querySelector<HTMLTextAreaElement>(".dotfile-desc")!.value.trim();
      const idInput = card.querySelector<HTMLInputElement>(".dotfile-id")!;
      const nameInput = card.querySelector<HTMLInputElement>(".dotfile-name")!;
      const descInput = card.querySelector<HTMLTextAreaElement>(".dotfile-desc")!;
      if (!id) return fail("Every dotfile needs an ID.", idInput);
      if (!name) return fail("Every dotfile needs a name.", nameInput);
      if (!desc) return fail("Every dotfile needs a description.", descInput);
      if (!/^[a-zA-Z0-9_-]+$/.test(id)) return fail("Each dotfile ID may contain only letters, numbers, _ and -.", idInput);
      const images = [...card.querySelectorAll<HTMLInputElement>(".image-url")].map((input) => input.value.trim()).filter(Boolean);
      if (images.some((image) => !isHttpsUrl(image))) return fail("Images must use public HTTPS URLs.", card.querySelector<HTMLInputElement>(".image-url")!);
      lines.push("", `[dotfiles.${id}]`, `name = ${quote(name)}`, `desc = ${quote(desc)}`);
      if (images.length) lines.push(`images = [${images.map(quote).join(", ")}]`);
    }
    const blob = new Blob([`${lines.join("\n")}\n`], { type: "application/toml" });
    const download = document.createElement("a");
    download.href = URL.createObjectURL(blob); download.download = "dot-miru.toml"; download.click(); URL.revokeObjectURL(download.href);
  });
</script>
