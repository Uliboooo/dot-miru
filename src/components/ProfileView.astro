---
import type { Profile } from "../lib/profile";
import type { Locale } from "../lib/i18n";

interface Props {
  profile: Profile;
  source?: string;
  locale: Locale;
}

const { profile, source, locale } = Astro.props;
const isJapanese = locale === "ja";
const formatStorage = (value: number) =>
  value < 1 ? `${Math.round(value * 1024)} GB` : `${value} TB`;
const socialId = (id: string) => id.replace(/^@/, "");
const socialLinks = [
  profile.sns?.github && {
    label: "GitHub",
    href: `https://github.com/${encodeURIComponent(socialId(profile.sns.github))}`,
  },
  profile.sns?.x && {
    label: "X",
    href: `https://x.com/${encodeURIComponent(socialId(profile.sns.x))}`,
  },
].filter(Boolean) as { label: string; href: string }[];
---

<article class="profile">
  <section class="profile-hero">
    {
      profile.info?.logo && (
        <img class="profile-logo" src={profile.info.logo} alt="" />
      )
    }
    <div>
      <p class="eyebrow">dotfiles profile</p>
      <h1>{profile.name}</h1>
      {profile.summary && <p class="summary">{profile.summary}</p>}
      {
        (profile.repository || socialLinks.length > 0) && (
          <div class="links">
            {profile.repository && (
              <a
                class="primary-link"
                href={profile.repository}
                target="_blank"
                rel="noreferrer"
              >
                {isJapanese ? "リポジトリを見る" : "View repository"}{" "}
                <span aria-hidden="true">↗</span>
              </a>
            )}
            {socialLinks.map((link) => (
              <a href={link.href} target="_blank" rel="noreferrer">
                {link.label} ↗
              </a>
            ))}
          </div>
        )
      }
      <div
        class="share-actions"
        aria-label={isJapanese ? "プロフィールを共有" : "Share this profile"}
      >
        <button
          type="button"
          class="share-button"
          data-share-x
          data-profile-name={profile.name}
        >
          {isJapanese ? "X に投稿" : "Post to X"}
        </button>
        <button type="button" class="share-button" data-copy-url>
          {isJapanese ? "URL をコピー" : "Copy URL"}
        </button>
        <span
          class="share-status"
          aria-live="polite"
          data-copied={isJapanese ? "コピーしました" : "Copied"}
          data-copy-failed={isJapanese ? "URL をコピーできませんでした" : "Could not copy URL"}
        ></span>
      </div>
    </div>
  </section>

  {
    profile.info && (
      <section class="machine" aria-labelledby="machine-title">
        <p class="eyebrow" id="machine-title">
          {isJapanese ? "マシン" : "machine"}
        </p>
        <dl>
          {profile.info.os && (
            <div>
              <dt>OS</dt>
              <dd>{profile.info.os}</dd>
            </div>
          )}
          {profile.info.kernel && (
            <div>
              <dt>Kernel</dt>
              <dd>{profile.info.kernel}</dd>
            </div>
          )}
          {profile.info.shell && (
            <div>
              <dt>Shell</dt>
              <dd>{profile.info.shell}</dd>
            </div>
          )}
          {profile.info.wm && (
            <div>
              <dt>WM</dt>
              <dd>{profile.info.wm}</dd>
            </div>
          )}
          {profile.info.de && (
            <div>
              <dt>DE</dt>
              <dd>{profile.info.de}</dd>
            </div>
          )}
          {profile.info.cursorTheme && (
            <div>
              <dt>{isJapanese ? "カーソルテーマ" : "Cursor theme"}</dt>
              <dd>{profile.info.cursorTheme}</dd>
            </div>
          )}
          {profile.info.terminal && (
            <div>
              <dt>Terminal</dt>
              <dd>{profile.info.terminal}</dd>
            </div>
          )}
          {profile.info.fonts?.length && (
            <div>
              <dt>Fonts</dt>
              <dd>{profile.info.fonts.join(", ")}</dd>
            </div>
          )}
          {profile.info.cpu && (
            <div>
              <dt>CPU</dt>
              <dd>{profile.info.cpu}</dd>
            </div>
          )}
          {profile.info.gpu && (
            <div>
              <dt>GPU</dt>
              <dd>{profile.info.gpu}</dd>
            </div>
          )}
          {profile.info.theme && (
            <div>
              <dt>Theme</dt>
              <dd>{profile.info.theme}</dd>
            </div>
          )}
          {profile.info.ramGb && (
            <div>
              <dt>{isJapanese ? "メモリ" : "Memory"}</dt>
              <dd>{profile.info.ramGb} GB</dd>
            </div>
          )}
          {profile.info.ssdTb?.length && (
            <div>
              <dt>SSD</dt>
              <dd>{profile.info.ssdTb.map(formatStorage).join(" + ")}</dd>
            </div>
          )}
          {profile.info.hddTb?.length && (
            <div>
              <dt>HDD</dt>
              <dd>{profile.info.hddTb.map(formatStorage).join(" + ")}</dd>
            </div>
          )}
        </dl>
        {profile.info.extra && Object.keys(profile.info.extra).length > 0 && (
          <div class="extra-info">
            <p class="eyebrow">{isJapanese ? "追加情報" : "additional info"}</p>
            <dl>
              {Object.entries(profile.info.extra).map(([key, value]) => (
                <div>
                  <dt>{key}</dt>
                  <dd>{value}</dd>
                </div>
              ))}
            </dl>
          </div>
        )}
      </section>
    )
  }

  <section class="dotfiles" aria-labelledby="dotfiles-title">
    <div class="section-heading">
      <p class="eyebrow" id="dotfiles-title">
        {isJapanese ? "設定" : "configuration"}
      </p><span>{profile.dotfiles.length} {isJapanese ? "項目" : "items"}</span>
    </div>
    {
      profile.dotfiles.length ? (
        <div class="dotfile-list">
          {profile.dotfiles.map((dotfile) => (
            <article class="dotfile-card">
              <h2>{dotfile.name}</h2>
              <p>{dotfile.desc}</p>
              {dotfile.images.length > 0 && (
                <div class="image-grid">
                  {dotfile.images.map((image, index) => (
                    <figure class="image-figure">
                      <button
                        class="image-button"
                        type="button"
                        data-image={image.url}
                        data-label={
                          image.alt || `${dotfile.name} screenshot ${index + 1}`
                        }
                      >
                        <img
                          src={image.url}
                          alt={
                            image.alt ||
                            `${dotfile.name} screenshot ${index + 1}`
                          }
                          loading="lazy"
                        />
                      </button>
                      <figcaption>
                        {image.alt || `${dotfile.name} screenshot ${index + 1}`}
                      </figcaption>
                    </figure>
                  ))}
                </div>
              )}
            </article>
          ))}
        </div>
      ) : (
        <p class="empty">
          {isJapanese
            ? "公開中の dotfiles はまだありません。"
            : "No public dotfiles have been added yet."}
        </p>
      )
    }
  </section>
  {
    source && (
      <p class="source-note">
        {isJapanese ? "ソース: " : "Source: "}
        <a href={source} target="_blank" rel="noreferrer">
          raw TOML ↗
        </a>
      </p>
    )
  }
</article>

<dialog class="image-dialog" aria-label="Screenshot preview">
  <button class="dialog-close" type="button" aria-label="Close preview"
    >×</button
  >
  <img alt="" />
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>(".image-dialog");
  const preview = dialog?.querySelector("img");
  document
    .querySelectorAll<HTMLButtonElement>(".image-button")
    .forEach((button) => {
      button.addEventListener("click", () => {
        if (!dialog || !preview) return;
        preview.src = button.dataset.image ?? "";
        preview.alt = button.dataset.label ?? "Screenshot preview";
        dialog.showModal();
      });
    });
  dialog
    ?.querySelector(".dialog-close")
    ?.addEventListener("click", () => dialog.close());
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });

  const shareStatus = document.querySelector<HTMLElement>(".share-status");
  const copyButton = document.querySelector<HTMLButtonElement>("[data-copy-url]");
  const xButton = document.querySelector<HTMLButtonElement>("[data-share-x]");

  xButton?.addEventListener("click", () => {
    const name = xButton.dataset.profileName ?? "dot-miru";
    const text = `${name} — dot-miru\n${window.location.href}`;
    window.open(`https://x.com/intent/post?text=${encodeURIComponent(text)}`, "_blank", "noopener,noreferrer");
  });

  copyButton?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(window.location.href);
      if (shareStatus) shareStatus.textContent = shareStatus.dataset.copied ?? "Copied";
    } catch {
      if (shareStatus) shareStatus.textContent = shareStatus.dataset.copyFailed ?? "Could not copy URL";
    }
  });
</script>
