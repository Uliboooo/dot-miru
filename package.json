{
  "name": "dot-miru",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "build:preview": "astro check && CLOUDFLARE_ENV=preview astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "migrate:production": "wrangler d1 migrations apply dot-miru-profiles --remote",
    "migrate:preview": "wrangler d1 migrations apply DB --remote --env preview",
    "deploy": "bun run build && bun run migrate:production && wrangler deploy",
    "deploy:preview": "bun run build:preview && bun run migrate:preview && wrangler deploy --env preview"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.7",
    "astro": "^7.2.0",
    "smol-toml": "^1.4.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "wrangler": "^4.123.0"
  }
}
